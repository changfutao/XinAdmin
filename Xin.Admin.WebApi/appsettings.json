{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // 项目启动url,如果改动端口前端对应devServer也需要进行修改
  "urls": "http://localhost:8888",
  // 跨域地址
  "CorsUrls": [ "http://localhost:51767", "http://localhost:8080" ],
  // 数据库配置
  "DbConfigs": [
    {
      "Name": "SqlServerFlag", // 实体名
      "Conn": "Data Source=192.168.13.45;User Id=sa;Password=123;Initial Catalog=XinAdmin;Encrypt=True;TrustServerCertificate=True;Pooling=true;Min Pool Size=1",
      "DbType": 1, // 数据库类型 MySql = 0, Sqlserver = 1, Oracle = 3, PgSql = 4
      "ConfigId": "0", // 多租户唯一标识
      "IsAutoCloseConnection": true
    }
  ],
  // Redis服务配置
  "RedisServer": {
    "Enable": true,
    "Cache": "192.168.13.45:6379,defaultDatabase=0,poolsize=50,ssl=false,writeBuffer=10240,prefix=cache:",
    "Session": "127.0.0.1:6379,defaultDatabase=0,poolsize=50,ssl=false,writeBuffer=10240,prefix=session:"
  },
  // JWT
  "JwtSettings": {
    "Issuer": "http://localhost:8888/", //即token的签发者。
    "Audience": "http://localhost:8887/", //指该token是服务于哪个群体的（群体范围）
    "SecretKey": "SecretKey-ZRADMIN.NET-20210101123123asdasdasd123",
    "Expire": 1440, //jwt登录过期时间（分）
    "RefreshTokenTime": 30, //分钟
    "TokenType": "Bearer"
  },
  // Serilog
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "Override": {
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/Info/info-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "rollOnFileSizeLimit": true, // 限制文件大小
          "fileSizeLimitBytes": 1048576,
          "retainedFileCountLimit ": 20
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/Error/error-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Error",
          "rollOnFileSizeLimit": true, // 限制文件大小
          "fileSizeLimitBytes": 1048576,
          "retainedFileCountLimit ": 20
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Destructure": [
      {
        "Name": "ToMaximumDepth",
        "Args": { "maximumDestructuringDepth": 4 }
      },
      {
        "Name": "ToMaximumStringLength",
        "Args": { "maximumStringLength": 100 }
      },
      {
        "Name": "ToMaximumCollectionCount",
        "Args": { "maximumCollectionCount": 10 }
      }
    ],
    "Properties": {
      "Application": "Sample"
    }
  }
}
